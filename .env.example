# ---------------------------------------------------------------------------
# PasarGuard / vpn-ui — sample environment file
# Copy to .env and edit:   cp .env.example .env && nano .env
# Never commit the real .env (it is git-ignored).
# ---------------------------------------------------------------------------

# Public address of the server: an IP or a domain name (no scheme, no slash).
# install.sh auto-detects this if left empty.
SERVER_IP=

# The one TCP+UDP port the panel and the VPN inbounds listen on.
VPN_PORT=20004

# Panel host used for links/cookies. Leave empty to reuse SERVER_IP.
PANEL_HOST=

# First admin username (created once, on a fresh volume).
ADMIN_USERNAME=admin

# Admin password used to seed the first admin on a fresh volume.
# CHANGE THIS. Minimum 8 characters.
ADMIN_PASSWORD=change-me-please

# Access scheme: https (self-signed cert by default) or http.
SUB_SCHEME=https
PUBLIC_TLS=1
